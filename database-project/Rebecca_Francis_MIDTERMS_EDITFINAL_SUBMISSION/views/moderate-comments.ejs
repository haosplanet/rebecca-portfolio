<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moderate Comments</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Junge&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/author-css/moderate-comments.css">
</head>
<body>
    <!-- Header -->
    <header>
        <!-- home link with home icon -->
        <a href="/" class="home-link">
            <img src="/images/home-icon.png" alt="Home">
        </a>
        <!-- blog title -->
        <h1><%= blogTitle %></h1>
        <!-- blog subtitle -->
        <h2><%= blogSubtitle %></h2>
        <!-- author name -->
        <h3><%= authorName %></h3>
        <!-- page Title -->
        <h4>~ MODERATE COMMENTS ~</h4>
    </header>

    <!-- Navigation -->
    <nav>
        <ul>
            <!-- link to authors home page -->
            <li><a href="/authors">Back to Author Homepage</a></li>
            <!-- link to reader article page -->
            <li><a href="/readers/article/<%= articleId %>">View Article</a></li>
        </ul>
    </nav>

    <!-- Divider -->
    <div class="divider"></div>

    <!-- Article Comments Section Header-->
    <h3>Article Comments:</h3>

    <!-- Article Comments Section -->
    <div class="comments-container">
        <!-- unordered list to contain all comments-->
        <ul class="comments-list">
            <!-- loops through each comment in the comments array -->
            <% comments.forEach(comment => { %>
                <!-- list items for each comment with the corresponding data attributes for comment ID and status -->
                <li class="comment-item" data-comment-id="<%= comment.id %>" data-status="<%= comment.moderated ? (comment.approved ? 'approved' : 'pending') : 'pending' %>">
                    <!-- displays comment avatar -->
                    <div class="comment-avatar">
                        <img src="/images/<%= comment.avatar %>" alt="Avatar Icon" class="icon">
                    </div>
                    <!-- displays comment content with commenter name -->
                    <div class="comment-content">
                        <p>Commented By : <strong><%= comment.commenterName %></strong></p>
                        <p><%= comment.commentContent %></p>
                    </div>
                    <!-- displays comment status and date of when comment was posted -->
                    <div class="comment-published-date">
                        <p>Status: <%= comment.moderated ? (comment.approved ? 'Approved' : 'Pending') : 'Pending' %></p>
                        <p>Posted on <%= comment.createdAt %></p>
                    </div>
                    <!-- displays comment buttons -->
                    <div class="comment-buttons">
                        <!-- displays approve button but visible only when comment has yet been moderated -->
                        <% if (!comment.moderated) { %>
                            <button onclick="approveComment('<%= articleId %>', '<%= comment.id %>')" class="btn-approve-comment">Approve</button>
                        <% } %>
                        <!-- displays delete button -->
                        <button onclick="deleteComment('<%= articleId %>', '<%= comment.id %>')" class="btn-delete-comment">Delete</button>
                    </div>
                    <!-- comment reaction section -->
                    <div class="comment">
                        <!-- shows the comment reactions and adds the corresponding buttons -->
                        <div class="comment-reactions">
                            <!-- form for thumbs-up reaction -->
                            <form action="/authors/reaction/thumbs-up/<%= comment.id %>" method="POST" id="thumbs-up-form-<%= comment.id %>" style="display:inline;">
                                <!-- thumbs-up button with onclick handler to update the reaction -->
                                <button type="submit" id="thumbs-up-button-<%= comment.id %>" onclick="updateReaction(event, '<%= comment.id %>', 'thumbs-up')">
                                    <!-- thumbs-up icon and will change based on the thumbs-up status -->
                                    <img src="/images/<%= comment.thumbsUp ? 'thumbsup-filled.png' : 'thumbsup-empty.png' %>" alt="Thumbs Up" class="reaction-icon">
                                    <!-- displays the thumbs-up count -->
                                    <span id="thumbs-up-count-<%= comment.id %>"><%= comment.thumbsUp %></span>
                                </button>
                            </form>
                            <!-- form for thumbs-down reaction -->
                            <form action="/authors/reaction/thumbs-down/<%= comment.id %>" method="POST" id="thumbs-down-form-<%= comment.id %>" style="display:inline;">
                                <!-- thumbs-down button with onclick handler to update the reaction -->
                                <button type="submit" id="thumbs-down-button-<%= comment.id %>" onclick="updateReaction(event, '<%= comment.id %>', 'thumbs-down')">
                                    <!-- thumbs-down icon and will change based on the thumbs-down status -->
                                    <img src="/images/<%= comment.thumbsDown ? 'thumbsdown-filled.png' : 'thumbsdown-empty.png' %>" alt="Thumbs Down" class="reaction-icon">
                                    <!-- displays the thumbs-down count -->
                                    <span id="thumbs-down-count-<%= comment.id %>"><%= comment.thumbsDown %></span>
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Reply Comments Section -->
                    <div class="reply-comment-section">
                        <!-- header for reply section -->
                        <h4>Reply by Author:</h4>
                        <!-- unordered list to contain all replies for the comment -->
                        <ul class="reply-list" id="reply-list-<%= comment.id %>">
                            <!-- replies will be loaded here -->
                        </ul>
                        <!-- button to toggle the reply form -->
                        <button onclick="toggleReplyForm('<%= comment.id %>')" class="btn-add-reply">Add Reply</button>
                        <!-- displays a reply form that is initially hidden -->
                        <div class="reply-form" id="reply-form-<%= comment.id %>" style="display: none;">
                            <!-- textarea for the reply content -->
                            <textarea id="reply-commentContent-<%= comment.id %>" rows="4" placeholder="Your Reply"></textarea>
                            <!-- button to submit the reply -->
                            <button onclick="submitReply('<%= comment.id %>')" class="btn-submit-reply">Submit Reply</button>
                        </div>
                    </div>
                </li>
            <% }); %>
        </ul>
    </div>

     <!-- adds JavaScript to handle comment moderation and reactions sorting -->
    <script>
        //function to update reaction
        function updateReaction(event, commentId, reactionType) {
            event.preventDefault(); //prevents the form from submitting normally
            //retrieves the form element associated with the specific reaction type and comment ID
            const form = document.getElementById(`${reactionType}-form-${commentId}`);
            //retrieves the button element associated with the specific reaction type and comment ID
            const button = document.getElementById(`${reactionType}-button-${commentId}`);
            //retrieves the image element inside the button (e.g., an icon or image representing the reaction)
            const image = button.querySelector('img');
            //retrievea the span element that displays the count of reactions for the specific reaction type and comment ID
            const countSpan = document.getElementById(`${reactionType}-count-${commentId}`);

            //updates the reaction in the backend using the POST method
            fetch(form.action, {
                method: 'POST',
                //sets the request header for URL-encoded form data
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                //sends the reaction type as form data
                body: new URLSearchParams({ action: reactionType })
            })
            .then(response => {
                //checks if the response status is OK
                if (response.ok) {
                    //toggles the image source and updates the corresponding reaction count
                    //checks if the reaction type is thumbs up
                    if (reactionType === 'thumbs-up') {
                        //toggles the thumbs-up image between filled and empty
                        image.src = image.src.includes('thumbsup-empty.png') ? '/images/thumbsup-filled.png' : '/images/thumbsup-empty.png';
                        //updates the count based on the image source
                        countSpan.textContent = parseInt(countSpan.textContent) + (image.src.includes('thumbsup-filled.png') ? 1 : -1);
                    } 
                    //checks if the reaction type is thumbs down
                    else {
                        //toggles the thumbs-down image between filled and empty
                        image.src = image.src.includes('thumbsdown-empty.png') ? '/images/thumbsdown-filled.png' : '/images/thumbsdown-empty.png';
                        //updates the count based on the image source
                        countSpan.textContent = parseInt(countSpan.textContent) + (image.src.includes('thumbsdown-filled.png') ? 1 : -1);
                    }
                } else {
                    //displays an alert if the response status is not OK
                    alert('Failed to update reaction');
                }
            })
            .catch(error => {
                 //logs and alerts an error message if there is a problem with the fetch request
                console.error('Error updating reaction:', error);
                alert('An error occurred while updating the reaction.');
            });
        }

        //function to approve a comment by fetching a POST request to the server
        function approveComment(articleId, commentId) {
            fetch(`/authors/moderate-comments/${articleId}/${commentId}`, {
                method: 'POST',
                //sets the request header for URL-encoded form data
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                //sends the action to approve the comment as form data
                body: new URLSearchParams({ action: 'approve' })
            })
            .then(response => {
                //checks if the response status is OK
                if (response.ok) {
                    //selects the comment block element with the specific comment ID
                    const commentBlock = document.querySelector(`.comment-item[data-comment-id="${commentId}"]`);
                    //checks if the comment block element is found
                    if (commentBlock) {
                        //updates the data-status attribute of the comment block to 'approved'
                        commentBlock.setAttribute('data-status', 'approved');
                        //finds the status element within the comment block and updates its text
                        const statusElement = commentBlock.querySelector('.comment-published-date p:first-of-type');
                        statusElement.innerText = 'Status: Approved';
                        //hides the approve button within the comment block
                        const approveButton = commentBlock.querySelector('.btn-approve-comment');
                        if (approveButton) approveButton.style.display = 'none';
                    }
                } else {
                    //displays an alert if the response status is not OK
                    alert('Failed to approve comment');
                }
            })
            .catch(error => {
                //logs and alerts an error message if there is a problem with the fetch request
                console.error('Error approving comment:', error);
                alert('An error occurred while approving the comment.');
            });
        }

        //function to delete a comment
        function deleteComment(articleId, commentId) {
            //adds a prompt for the user to confirm the deletion action
            const isConfirmed = confirm('Are you sure you want to delete this comment? This action cannot be undone.');
            //exits the function if the user does not confirm
            if (!isConfirmed) return;

            //sends a DELETE request to the server to delete the specific comment
            fetch(`/authors/moderate-comments/${articleId}/${commentId}`, {
                method: 'DELETE',
                //sets the request header for URL-encoded form data
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            })
            .then(response => {
                //checks if the response status is OK
                if (response.ok) {
                    //selects the comment block element with the specific comment ID
                    const commentBlock = document.querySelector(`.comment-item[data-comment-id="${commentId}"]`);
                    //removes the comment block element from the DOM
                    if (commentBlock) commentBlock.remove();
                } else {
                    //displays an alert if the response status is not OK
                    alert('Failed to delete comment');
                }
            })
            .catch(error => {
                //logs and alerts an error message if there is a problem with the fetch request
                console.error('Error deleting comment:', error);
                alert('An error occurred while deleting the comment.');
            });
        }

        //function to toggle the reply form
        function toggleReplyForm(commentId) {
            //retrieves the reply form element associated with the specific comment ID
            const replyForm = document.getElementById(`reply-form-${commentId}`);
            //toggles the display style of the reply form between 'none' and 'block'
            replyForm.style.display = replyForm.style.display === 'none' ? 'block' : 'none';
        }

        //function to submit a reply
        function submitReply(commentId) {
            //retrieves the value of the reply content input field
            const commentContent = document.getElementById(`reply-commentContent-${commentId}`).value;

            //checks if the reply content is empty
            if (!commentContent) {
                //alerts the user if the reply content is empty
                alert('Content is required to submit a reply.');
                 //exits the function if the reply content is empty
                return;
            }

            //sends a POST request to the server to submit the reply
            fetch(`/authors/reply/${commentId}`, {
                method: 'POST',
                //sets the request header for URL-encoded form data
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                //sends the reply content and avatar as form data
                body: new URLSearchParams({ commentContent, avatar: 'default-avatar.png' }) 
            })
            .then(response => {
                //checks if the response status is OK
                if (response.ok) {
                    //reloads the replies for the comment
                    loadReplies(commentId); 
                    //hides the reply form
                    document.getElementById(`reply-form-${commentId}`).style.display = 'none';
                } else {
                    //displays an alert if the response status is not OK
                    alert('Failed to submit reply');
                }
            })
            .catch(error => {
                //logs and alerts an error message if there is a problem with the fetch request
                console.error('Error submitting reply:', error);
                alert('An error occurred while submitting the reply.');
            });
        }

        //function to load replies for a comment
        function loadReplies(commentId) {
            //sends a GET request to the server to fetch replies for the specific comment
            fetch(`/authors/replies/${commentId}`)
            .then(response => {
                //checks if the response status is OK
                if (response.ok) {
                    //parses the response body as JSON
                    return response.json();
                } else {
                    //logs an error if the response status is not OK
                    console.error('Failed to load replies');
                    //throws an error to be caught in the catch block
                    throw new Error('Failed to load replies');
                }
            })
            .then(replies => {
                //selects the list element to display the replies
                const replyList = document.getElementById(`reply-list-${commentId}`);
                //clears any existing content in the reply list
                replyList.innerHTML = ''; 

                //iterates over each reply and creates a list item for it
                replies.forEach(reply => {
                    const replyItem = document.createElement('li');
                    replyItem.className = 'reply-item';
                    
                    //sets the inner HTML of the reply item with reply content and metadata
                    replyItem.innerHTML = `
                        <div class="reply-avatar">
                            <p><img src="/images/default-avatar.png" alt="Avatar Icon" class="avatar-icon"></p>
                        </div>
                        <div class="reply-content">
                            <p>${reply.commentContent}</p>
                        </div>
                        <div class="reply-published-date">
                            <p>Posted on ${reply.createdAt}</p>
                        </div>
                    `;
                    //appends the reply item to the reply list
                    replyList.appendChild(replyItem);
                });
            })
            .catch(error => {
                //logs an error message if there is a problem with the fetch request
                console.error('Error loading replies:', error);
            });
        }

        //loads the intial replies for each comment
        document.querySelectorAll('.comment-item').forEach(commentItem => {
            const commentId = commentItem.getAttribute('data-comment-id');
            //loads replies for each comment found on the page
            loadReplies(commentId); 
        });

    </script>
</body>
</html>
